{
  "weft": 1,
  "kind": "theme",
  "api": 1,
  "id": "midnight",
  "name": "Midnight",
  "version": "1.1.0",
  "description": "Deep ink blue, a teal accent and liquid glass over a background you pick: a dotted night sky, a teal tide, plain ink, a recommended wallpaper, or your own picture, GIF or video. Styles only (one theme.css on top of the dashboard's own), so it can't run code and keeps working as Aegis updates. Copy it to start your own theme.",
  "author": "Weft",
  "license": "MIT",
  "homepage": "https://github.com/alexd-aero/weft/tree/main/examples/themes/midnight",
  "requires": {
    "burrow": ">=2.45.0"
  },
  "accent": "#2dd4bf",
  "previews": [
    {
      "file": "previews/home.webp",
      "caption": "Home"
    },
    {
      "file": "previews/burrow.webp",
      "caption": "Burrow"
    },
    {
      "file": "previews/settings.webp",
      "caption": "Settings"
    }
  ],
  "onboarding": [
    {
      "title": "Liquid glass",
      "body": "Every card, menu and dialog is a pane of tinted glass that blurs whatever is behind it, so Midnight looks best over a picture. Pick one any time: Settings → Themes → Background."
    },
    {
      "title": "Made with one stylesheet",
      "body": "Everything Midnight changes is in theme.css: CSS variables and a few rules, layered on top of Aegis's own styles, plus the backgrounds list in .theme. Fork alexd-aero/weft, copy examples/themes/midnight, and change the colors to make yours."
    }
  ],
  "backgrounds": {
    "builtin": [
      {
        "id": "night",
        "name": "Night sky",
        "swatch": "radial-gradient(circle at 50% 0%, rgba(45,212,191,.35), transparent 60%), radial-gradient(rgba(160,190,255,.5) 1px, transparent 1.4px) 0 0 / 8px 8px, #070b16"
      },
      {
        "id": "tide",
        "name": "Tide",
        "swatch": "radial-gradient(circle at 15% 10%, rgba(45,212,191,.6), transparent 60%), radial-gradient(circle at 90% 30%, rgba(99,102,241,.6), transparent 60%), radial-gradient(circle at 50% 120%, rgba(14,116,144,.6), transparent 60%), #081226"
      },
      {
        "id": "ink",
        "name": "Ink",
        "swatch": "#05070d"
      }
    ],
    "default": "night",
    "recommended": [
      {
