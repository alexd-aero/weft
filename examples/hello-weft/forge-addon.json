{
  "spec": 1,
  "id": "hello-weft",
  "name": "Hello Weft",
  "version": "1.0.0",
  "description": "The smallest complete Weft addon: every lifecycle script, two settings, an action, a status with a port, a page, and an entry on the Weft mesh. Start every new addon from a copy of this folder.",
  "author": "The Weft Architecture",
  "homepage": "https://github.com/alexd-aero/weft/tree/main/examples/hello-weft",
  "license": "MIT",
  "logo": "logo.svg",
  "requires": {
    "forge": ">=1.10.0",
    "burrow": ">=2.0.0",
    "os": [
      "linux"
    ],
    "commands": [
      "bash",
      "python3",
      "curl"
    ]
  },
  "scripts": {
    "detect": "weft/detect.sh",
    "install": "weft/install.sh",
    "update": "weft/install.sh",
    "uninstall": "weft/uninstall.sh",
    "status": "weft/status.sh"
  },
  "actions": [
    {
      "id": "restart",
      "label": "Restart",
      "script": "weft/restart.sh"
    }
  ],
  "settings": [
    {
      "key": "PORT",
      "label": "Port",
      "type": "number",
      "default": 8791,
      "min": 1024,
      "max": 65535,
      "help": "Where its page listens, on the same address as its host."
    },
    {
      "key": "GREETING",
      "label": "Greeting",
      "type": "text",
      "default": "Hello from a Weft addon",
      "help": "The line its page shows."
    }
  ],
  "links": [
    {
      "label": "The Weft Architecture",
      "url": "https://github.com/alexd-aero/weft"
    },
    {
      "label": "This example, explained",
      "url": "https://github.com/alexd-aero/weft/tree/main/examples/hello-weft#readme"
    }
  ]
}
